{
  "name": "vue3-boilerplate",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node service/commands/dev.js",
    "build": "npm run type-check && node service/commands/build.js",
    "lint": "npm run lint:prettier && npm run lint:eslint && npm run lint:stylelint",
    "lint:prettier": "prettier . --write --log-level warn",
    "lint:eslint": "eslint --fix",
    "lint:stylelint": "stylelint \"./src/**/*.{vue,css,pcss,postcss,scss}\" --fix",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
