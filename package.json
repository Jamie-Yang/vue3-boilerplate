    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vue/babel-plugin-jsx": "^3.0.0",
